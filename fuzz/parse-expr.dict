# libFuzzer dictionary for fuzz-parse-expr: the tokens the lexer recognises
# (lib/hobbes/read/pgen/hexpr.l). Keeping these intact through mutation lets
# the fuzzer reach the parser instead of stalling on lexical errors.

# keywords
"option"
"module"
"where"
"import"
"type"
"data"
"class"
"instance"
"exists"
"let"
"in"
"case"
"default"
"match"
"matches"
"parse"
"with"
"of"
"and"
"or"
"not"
"if"
"then"
"else"
"true"
"false"
"pack"
"unpack"
"do"
"return"
"fn"
"UNSAFE"
"SAFE"

# operators and type/binding syntax
"<-"
"="
"::"
"=>"
":="
":"
"->"
"=="
"==="
"!="
"~"
"<="
">="
"++"
".."
"|"
"\\"
"@"
"$"
"^"
"%"

# brackets, comments, pragmas
"("
")"
"["
"]"
"{"
"}"
"//"
"/*"
"*/"
"{-#"
"#-}"

# literals and shapes that exercise deeper grammar rules
"0x"
"0.0"
"'c'"
"\"s\""
"[1..10]"
"{a=1}"
"|x=1|"
